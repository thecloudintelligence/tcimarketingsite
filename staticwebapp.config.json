{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/static/*",
      "/img/*",
      "*.css",
      "*.js",
      "*.json",
      "*.png",
      "*.jpg",
      "*.svg",
      "*.ico",
      "*.woff",
      "*.woff2"
